## 8. MISSING DATABASE CONSTRAINTS

### 8.1 Required Constraints (Not Yet Applied)

```sql
-- 1. Unique constraint to prevent duplicate adjustments
ALTER TABLE dbo.payroll_manual_adjustments
ADD CONSTRAINT UX_payroll_manual_adjustments_period_emp_adj
UNIQUE (period_month, period_year, emp_code, adjustment_name, gang_code);

-- 2. JSON validation for metadata_json
ALTER TABLE dbo.payroll_manual_adjustments
ADD CONSTRAINT CHK_payroll_manual_adjustments_metadata_json
CHECK (metadata_json IS NULL OR TRY_CAST(metadata_json AS JSON) IS NOT NULL);

-- 3. Check constraint for amount
ALTER TABLE dbo.payroll_manual_adjustments
ADD CONSTRAINT CHK_payroll_manual_adjustments_amount
CHECK (amount >= 0);

-- 4. Check constraint for period
ALTER TABLE dbo.payroll_manual_adjustments
ADD CONSTRAINT CHK_payroll_manual_adjustments_period
CHECK (period_month >= 1 AND period_month <= 12
 AND period_year >= 2000 AND period_year <= 2100);

-- 5. Composite indexes for performance
CREATE INDEX IX_payroll_manual_adjustments_period_emp
ON dbo.payroll_manual_adjustments (period_month, period_year, emp_code);

CREATE INDEX IX_payroll_manual_adjustments_period_gang
ON dbo.payroll_manual_adjustments (period_month, period_year, gang_code);

CREATE INDEX IX_payroll_manual_adjustments_period_div
ON dbo.payroll_manual_adjustments (period_month, period_year, division_code);
```

### 8.2 employee_other_incomes Constraints

```sql
-- Unique constraint for upsert
ALTER TABLE dbo.employee_other_incomes
ADD CONSTRAINT UX_employee_other_incomes_period_emp_income
UNIQUE (period_month, period_year, nik, income_name);

-- Alternative: by emp_code
ALTER TABLE dbo.employee_other_incomes
ADD CONSTRAINT UX_employee_other_incomes_period_empcode_income
UNIQUE (period_month, period_year, emp_code, income_name);
```

