## 7. SQL Preview Query

**Query yang SEHARUSNYA dijalankan sebelum DELETE untuk melihat record terdampak:**

```sql
-- Preview: Cek berapa record akan terdampak sebelum deleteAdjustmentColumn
-- Params: period_month=5, period_year=2026, division_code='P1A', adjustment_type='PREMI', adjustment_name='PREMI PRUNING'
SELECT
    id,
    period_month,
    period_year,
    emp_code,
    emp_name,
    nik,
    gang_code,
    division_code,
    adjustment_type,
    adjustment_name,
    amount,
    metadata_json,
    created_at,
    created_by
FROM extend_db_ptrj.dbo.payroll_manual_adjustments
WHERE period_month = 5
  AND period_year = 2026
  AND adjustment_type = 'PREMI'
  AND UPPER(LTRIM(RTRIM(
      REPLACE(REPLACE(REPLACE(REPLACE(
          REPLACE(REPLACE(REPLACE(REPLACE(
              adjustment_name, CHAR(9), ' '), CHAR(10), ' '), CHAR(13), ' '), CHAR(160), ' ')
          , '  ', ' '), '  ', ' '), '  ', ' '), '  ', ' ')
      ))) = 'PREMI PRUNING'
  AND (division_code = 'P1A' OR division_code IS NULL OR LTRIM(RTRIM(division_code)) = '')
ORDER BY division_code, gang_code, emp_code;

-- Summary untuk UI confirmation:
SELECT
    COUNT(*) AS total_records_to_delete,
    COUNT(DISTINCT emp_code) AS unique_employees,
    COUNT(DISTINCT gang_code) AS unique_gangs,
    COUNT(DISTINCT division_code) AS unique_divisions,
    SUM(amount) AS total_amount
FROM extend_db_ptrj.dbo.payroll_manual_adjustments
WHERE period_month = 5
  AND period_year = 2026
  AND adjustment_type = 'PREMI'
  AND UPPER(LTRIM(RTRIM(
      REPLACE(REPLACE(REPLACE(REPLACE(
          REPLACE(REPLACE(REPLACE(REPLACE(
              adjustment_name, CHAR(9), ' '), CHAR(10), ' '), CHAR(13), ' '), CHAR(160), ' ')
          , '  ', ' '), '  ', ' '), '  ', ' '), '  ', ' ')
      ))) = 'PREMI PRUNING'
  AND (division_code = 'P1A' OR division_code IS NULL OR LTRIM(RTRIM(division_code)) = '');
```

